# Anthropic API key for the classifier (adaptive thinking).
# Use the MobUpps company key, not personal.
ANTHROPIC_API_KEY=sk-ant-...

# Port api-server binds to. Replit injects this; .replit pins it to 3001.
PORT=3001

# Google OAuth credentials (one-time setup, see SETUP.md)
# Get these from https://console.cloud.google.com → Credentials → OAuth Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL the app is reachable at (Replit deployment URL or dev workspace URL).
# Must match an Authorized redirect URI in your Google OAuth client config.
# e.g. https://ad-library-finder.username.repl.co
#
# NOTE THE NAME. The unified-domain runbook calls this "PUBLIC_URL"; the app has
# always read PUBLIC_BASE_URL and still does. Setting PUBLIC_URL instead does
# nothing except log a warning at boot, and every emailed result link goes out
# as a bare path that nobody can click from an inbox.
#
# When BASE_PATH is set, this value must ALREADY INCLUDE the prefix — the two
# are set together, e.g. https://tools.mobupps.net/leadfinder. The app refuses
# to boot if they disagree, because the alternative is emailing dead links.
PUBLIC_BASE_URL=

# URL prefix this app is mounted under, for serving behind the tools gateway.
# Unset (or "/") means "serve at the origin root" — today's behaviour, and every
# base-path code path is inert. Set it and the API mount, the static mount, the
# SPA fallback, the OAuth callback path, the session cookie's Path and the
# built asset URLs all move together. Rollback is unsetting it and redeploying.
#
# Must be set for BOTH the build and the run: the dashboard build stamps it into
# dist/index.html, so a server started with a prefix over a dist built without
# one serves an index.html whose assets 404.
#
# The session cookie is named als_session unprefixed and lf_session when
# prefixed, so the four tools on the shared origin cannot clobber each other.
# Flipping this therefore signs everyone out exactly once.
# BASE_PATH=/leadfinder

# Optional: cap concurrent Playwright contexts. Default 1.
SCRAPER_CONCURRENCY=1

# Optional: max pages per (country, keyword) pair. Default 5.
MAX_PAGES_PER_QUERY=5

# Optional: delay between page actions in ms. Default 2500 (random ±50%).
SCRAPE_ACTION_DELAY_MS=2500

# ── Google Ads Transparency source (all optional; sensible defaults baked in) ──
# Base host for the Transparency Center RPC endpoints.
# GOOGLE_ADS_BASE=https://adstransparency.google.com
# Advertisers requested per keyword (SearchSuggestions). Default 10.
# GOOGLE_ADS_SUGGEST_LIMIT=10
# Creatives requested per advertiser (SearchCreatives). Default 5.
# GOOGLE_ADS_CREATIVES_LIMIT=5
# GetCreativeById detail lookups per advertiser. Default 2.
# GOOGLE_ADS_CREATIVE_LOOKUPS_PER_ADV=2
# Per-job cap on total GetCreativeById lookups. Default 60.
# GOOGLE_ADS_MAX_LOOKUPS=60
# Per-job hard cap on advertisers processed. Default 1000.
# GOOGLE_ADS_MAX_ADVERTISERS=1000
# Default keyword sample size when a job doesn't specify one. Default 40.
# GOOGLE_ADS_DEFAULT_MAX_KEYWORDS=40
# Base polite delay between requests in ms. Default 1500. (Adaptively throttled
# UP after any 429/403 and eased back on success — see throttleFactor.)
# GOOGLE_ADS_FETCH_DELAY_MS=1500
# Per-request timeout in ms. Default 20000.
# GOOGLE_ADS_TIMEOUT_MS=20000
# Send the region in RPC filters (region is metadata, not a real filter). Default off.
# GOOGLE_ADS_SEND_REGION=0
# authuser index passed to the RPC endpoints. Default 0.
# GOOGLE_ADS_AUTHUSER=0
# Warm a cookie session (GET the homepage) before discovery so RPCs carry
# Google's consent/NID cookies. Default on; set 0 to disable.
# GOOGLE_ADS_WARMUP=1
# Retries on a soft block (429/403/challenge) before giving up on a request. Default 3.
# GOOGLE_ADS_MAX_RETRIES=3
# Exponential-backoff base / ceiling (ms) between those retries. Defaults 4000 / 30000.
# GOOGLE_ADS_BACKOFF_BASE_MS=4000
# GOOGLE_ADS_BACKOFF_MAX_MS=30000
# Outbound proxy for the Transparency Center scraper ONLY (OAuth/googleapis/LLM
# keep direct egress). From a datacenter IP Google 429s every request incl. the
# warm-up GET; route through a residential/mobile proxy to get an un-flagged exit
# IP. Use an http(s):// proxy (ProxyAgent tunnels HTTPS via CONNECT; SOCKS is not
# supported — use the provider's http/https port). Optional user:pass@. For rotating
# residential pools point this at the provider's gateway (it rotates the exit IP).
# Unset ⇒ direct egress (unchanged behaviour). Credentials are redacted in logs.
# A literal {session} placeholder anywhere in the URL (typically the username,
# e.g. user-session-{session}) is replaced with a fresh token on every exit
# rotation — use it with sticky-session pools so a rotation really changes the
# exit IP (check your provider's docs for their session-in-username syntax).
# GOOGLE_ADS_PROXY_URL=http://USER:PASS@gateway.provider.com:7000
# When the warm-up GET finds the current proxy exit IP penalty-boxed (429/403),
# the scraper rotates to a fresh exit — new connection pool + new {session}
# token — and re-warms, up to this many times, before declaring a hard block
# and latching the cooldown. 0 disables rotation. Default 2.
# GOOGLE_ADS_EXIT_ROTATIONS=2
# Neutral IP-echo endpoint fetched THROUGH the proxy to log which exit IP
# Google actually sees (proves whether rotation changed the IP). Must answer
# with the bare IP in the body. Never touches Google. Default api.ipify.org.
# GOOGLE_ADS_IP_ECHO_URL=https://api.ipify.org
# MOBILE jobs only: creative-format filter for SearchCreatives (payload field
# "4"). The internal RPC exposes NO platform (Search/YouTube/Maps) filter — the
# one working lever is creative FORMAT: 1=text, 2=image, 3=video. YouTube /
# Connected-TV app-install ads are VIDEO, and app-store destinations live in
# them, so mobile defaults to video-only (3). This is the "focus on YouTube/CTV"
# knob. Set 0 to search ALL formats (broader, more endpoint load, less focused).
# CPS/web jobs never touch creatives, so this does nothing to them.
# GOOGLE_ADS_MOBILE_CREATIVE_FORMAT=3
# MOBILE jobs only: the Play/App-Store URL is NOT in the GetCreativeById JSON —
# it lives inside the creative's "preview" render document (adurl= param). When a
# creative detail has no direct destination, the resolver fetches that preview
# once (through the proxy) and reads the store/click URL out. This is the hop
# that makes mobile leads resolve; without it mobile CSVs are empty. Set 0 to
# disable the extra fetch (mobile yield drops to ~0 again). Default on.
# GOOGLE_ADS_PREVIEW_FETCH=1
# Circuit breaker for the creative endpoint (mobile jobs). When SearchCreatives
# hard-blocks (429 after the full retry ladder), the pipeline PAUSES creative
# scraping and resolves the rest from verified domains only (instant, no network)
# — every lead found so far is already saved (the CSV is flushed on every insert).
# Trips on EITHER N hard-blocked-in-a-row (default 1 = stop on the first true
# block) OR a blocked-rate over a min sample. Raise BREAKER_AFTER to tolerate more.
# GOOGLE_ADS_BREAKER_AFTER=1
# GOOGLE_ADS_BREAKER_MIN_SAMPLE=6
# GOOGLE_ADS_BREAKER_RATE=0.6
# Abort discovery after N consecutive hard-blocked keywords (default 2). Leads
# are streamed to the CSV as found, so an early abort presents everything
# discovered so far instead of grinding the retry ladder keyword after keyword.
# GOOGLE_ADS_DISCOVERY_ABORT_AFTER=2
# After a PROVEN hard block (warm-up + probe both 429, or the consecutive-block
# abort), new google_ads jobs send ZERO requests for this window — every extra
# request renews Google's penalty and pushes recovery further away. Default
# 15 min; 0 disables. If the warm-up GET itself is 429, discovery probes ONE
# keyword without retries and aborts instantly instead of grinding backoffs.
# GOOGLE_ADS_COOLDOWN_MS=900000
# After a confirmed hard block WITH a proxy configured, the scraper sends ONE
# request to this neutral non-Google URL through the same proxy and logs whether
# the proxy egress is healthy (⇒ the 429s are Google's penalty) or the proxy
# provider itself is rate-limiting the account (⇒ check quota/plan). Never
# touches Google, so it cannot renew the penalty.
# GOOGLE_ADS_PROXY_HEALTH_URL=https://example.com/
# Proxy-Seller traffic monitor (optional). With the key set (dashboard → Custom
# API), every google_ads job checks the residential package's remaining GB before
# starting — warns when low, refuses to start when exhausted — and logs the job's
# actual traffic cost after. Fail-open: an unreachable/reshaped API never blocks
# a job. Unset ⇒ feature fully off.
# PROXY_SELLER_API_KEY=
# PROXY_TRAFFIC_WARN_GB=1
# PROXY_TRAFFIC_ABORT_GB=0.05
# CPS jobs skip the creative endpoint entirely (the lead is the advertiser's own
# site: verified domain first, else an Affplus-style name→web-search). This is
# also what keeps a proxy IP healthy — creative bursts are what get it flagged.
# Set =1 to restore per-creative landing-page lookups for CPS.
# GOOGLE_ADS_CPS_USE_CREATIVES=0
# Per-job cap on name→web-searches for advertisers with no verified domain
# (Anthropic web_search under the shared daily LLM cap; needs ANTHROPIC_API_KEY).
# GOOGLE_ADS_WEB_MAX_SEARCHES=40

# ── Outbound spend reporting to the Chief (order L-3.5a) ─────────────────────
# This app calls a paid vendor (the Anthropic API), keeps its own USD ledger and
# enforces its own $100/day cap. With BOTH variables below set, it also REPORTS
# that spend to the Chief: per UTC day, per vendor, in $0.50 quanta, one request
# per quantum to POST <CHIEF_URL>/api/ingest/spend with a Bearer token, each
# carrying an idempotent external_id so a retry can never double-count.
#
# Leave EITHER unset and the reporter is dormant — it logs one loud line per
# boot and changes nothing else. Dormant is safe but it means the Chief's
# all-reporters total is short by whatever this app spends.
#
# NOTE the two day boundaries, which are both correct and differ by three hours:
# the quanta reported here are counted per UTC day, while this app's own $100
# cap resets at Asia/Jerusalem midnight (21:00 UTC in summer). /api/chief/status
# serves both figures and names the window on each.
#
# CHIEF_INGEST_TOKEN is the Chief's INBOUND credential and is NOT the same
# secret as CHIEF_TOKEN, which is what this app checks on requests arriving FROM
# the Chief (and which equals the Chief's own LEAD_FINDER_TOKEN).
# CHIEF_URL=https://chief.example.com
# CHIEF_INGEST_TOKEN=
