# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Editor + package-manager caches. These dominate the image (~2.4GB of a 4.1GB
# push) and none of it is runtime state: .vscode-server is the IDE's remote
# server, and the npm/pnpm/node-gyp/tsc caches are rebuilt by the deployment's
# own build step (`pnpm install && pnpm install:playwright && pnpm build`).
# A smaller image pushes faster and spends less time exposed to registry errors.
#
# NOTE: .cache/ms-playwright is deliberately NOT excluded. browserSetup.ts
# resolves the Chromium binary out of .cache/ms-playwright/chromium-*/, and it is
# the only copy in this Repl — dropping it takes the GATC/CPS scraper offline.
.config/.vscode-server
.config/npm
.cache/pnpm
.cache/node-gyp
.cache/typescript
.cache/replit
.cache/fontconfig

# NEVER ship local dev state to a deployment. The dev SQLite DB carries dev
# jobs — the deploy's queue processor runs any 'pending' rows at boot, which
# once replayed stale smoke-test jobs against the live endpoint through the
# operator's proxy and got its IP rate-limited before real jobs even started.
data/
artifacts/api-server/data/
csv-output/
artifacts/api-server/csv-output/

# Do NOT exclude node_modules here. .replitignore is applied when packaging the
# final deployment image (after the build step), so excluding it strips the
# runtime dependencies the build just installed and the server crash-loops with
# ERR_MODULE_NOT_FOUND at boot.

# Verification sandboxes (scripts/smoke-store-first.mjs, verify-tail-confirm.mjs).
# Same rule as above — the patterns there match those two literal paths only, so
# the throwaway SQLite + CSV these write under a nested data/ would otherwise ship.
artifacts/api-server/.smoke-*
artifacts/api-server/.tail-confirm-check
