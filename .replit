modules = ["nodejs-20", "web", "python-3.11"]
run = "pnpm start"
hidden = [".pnpm-store", "node_modules", ".cache", "dist"]

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "pnpm install && pnpm install:playwright && pnpm build"]
run = ["sh", "-c", "pnpm start"]

[[ports]]
localPort = 3001
externalPort = 80

[env]
NODE_ENV = "production"
PORT = "3001"
PLAYWRIGHT_BROWSERS_PATH = "0"

[agent]
expertMode = true
