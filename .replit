modules = ["nodejs-20", "web", "python-3.11"]
run = "pnpm start"
hidden = [".pnpm-store", "node_modules", ".cache", "dist"]

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "pnpm install --prod=false && pnpm install:playwright && pnpm build"]
run = ["sh", "-c", "pnpm start"]

[[ports]]
localPort = 3001
externalPort = 80

[[ports]]
localPort = 3901
externalPort = 3000

[[ports]]
localPort = 3902
externalPort = 3001

[[ports]]
localPort = 3903
externalPort = 3002

[[ports]]
localPort = 3904
externalPort = 3003

[[ports]]
localPort = 3905
externalPort = 4200

[[ports]]
localPort = 3906
externalPort = 5000

[env]
NODE_ENV = "production"
PORT = "3001"
PLAYWRIGHT_BROWSERS_PATH = "0"

[agent]
expertMode = true

[nix]
